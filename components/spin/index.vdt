import {getRestProps} from '../utils';
import {makeStyles, makeDashAnimation} from './styles';

const {size, center, className, overlay, color, gradientFrom, gradientTo, gradientX1, gradientY1, gradientX2, gradientY2, strokeWidth} = this.get();
const { k } = this.config;
const _gradientId = this._gradientId;

const useGradient = gradientFrom?.trim() && gradientTo?.trim();
const strokePaint = useGradient ? `url(#k-spin-grad-${_gradientId})` : color;

const VIEWBOX = 120;
const HALF = VIEWBOX / 2;
const effectiveStrokeWidth = strokeWidth || 6;
const radius = HALF - effectiveStrokeWidth / 2;
const circumference = Math.round(2 * Math.PI * radius);
const dashLength = Math.round(circumference * 0.75);
const dashOffset25 = -Math.round(circumference * 0.25);
const dashOffsetFull = -circumference;

const dashAnimation = makeDashAnimation(circumference, dashLength, dashOffset25, dashOffsetFull);

const isNumericSize = typeof size === 'number';
const canvasStyle = isNumericSize ? `width: ${size}px; height: ${size}px` : undefined;
const circleStyle = `--c: ${circumference}; ${color || useGradient ? `--stroke: ${strokePaint};` : ''} animation: ${dashAnimation}`;

const classNameObj = {
    [`${k}-spin`]: true,
    [`${k}-${size}`]: !isNumericSize && size !== 'default',
    [`${k}-center`]: !overlay && center,
    [`${k}-overlay`]: overlay,
    [className]: className,
    [makeStyles(k)]: true,
};

const canvas = (
    <div class={`${k}-spin-canvas`} style={canvasStyle}>
        <b:canvas>
            <svg viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`} fill="none">
                <defs v-if={useGradient}>
                    <linearGradient
                        id={`k-spin-grad-${_gradientId}`}
                        x1={gradientX1}
                        y1={gradientY1}
                        x2={gradientX2}
                        y2={gradientY2}
                        gradientUnits="objectBoundingBox"
                    >
                        <stop offset="0%" stop-color={gradientFrom} />
                        <stop offset="100%" stop-color={gradientTo} />
                    </linearGradient>
                </defs>
                <circle
                    cx={HALF}
                    cy={HALF}
                    r={radius}
                    stroke-width={effectiveStrokeWidth}
                    class={`${k}-spin-circle`}
                    style={circleStyle}
                />
            </svg>
        </b:canvas>
    </div>
);

<div class={classNameObj} {...getRestProps(this)}>
    <div class={`${k}-spin-wrapper`} v-if={overlay}>{canvas}</div>
    <template v-else>{canvas}</template>
</div>
